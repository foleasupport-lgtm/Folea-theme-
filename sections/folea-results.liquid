<section class="results-section" id="resultsSection">
  <div class="container">
    <div class="results-card">
      <div class="results-image-box">
        <div class="ba-slider-container" id="baSliderContainer">
          <!-- After Image (Base Layer) -->
          <div class="ba-image-layer ba-after-layer">
            {%- if section.settings.image_after != blank -%}
              <img src="{{ section.settings.image_after | image_url: width: 900 }}" alt="Folea After Result">
            {%- else -%}
              <img src="{{ 'folea-after.jpg' | asset_url }}" alt="Folea After Hair Transformation">
            {%- endif -%}
            <span class="ba-badge ba-after-badge">AFTER</span>
          </div>

          <!-- Before Image (Draggable Top Layer) -->
          <div class="ba-image-layer ba-before-layer" id="baBeforeLayer">
            {%- if section.settings.image_before != blank -%}
              <img src="{{ section.settings.image_before | image_url: width: 900 }}" alt="Folea Before Result">
            {%- else -%}
              <img src="{{ 'folea-before.jpg' | asset_url }}" alt="Folea Before Hair Transformation">
            {%- endif -%}
            <span class="ba-badge ba-before-badge">BEFORE</span>
          </div>

          <!-- Draggable Divider Line & Button -->
          <div class="ba-divider" id="baDivider">
            <div class="ba-handle" aria-label="Drag to compare before and after">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </div>

          <!-- Native Range Input Overlaid for Smooth Universal Touch & Drag -->
          <input type="range" min="0" max="100" value="50" class="ba-range-input" id="baRangeInput" aria-label="Before and after transformation slider">
        </div>
      </div>

      <div class="results-content-box">
        <span class="sub-heading">{{ section.settings.sub_heading }}</span>
        <h2>{{ section.settings.title }}</h2>
        <p class="results-lead">{{ section.settings.lead }}</p>
        
        <div class="stat-pills">
          <div class="stat-pill">
            <span class="stat-number">{{ section.settings.stat_1_num }}</span>
            <span class="stat-label">{{ section.settings.stat_1_label }}</span>
          </div>
          <div class="stat-pill">
            <span class="stat-number">{{ section.settings.stat_2_num }}</span>
            <span class="stat-label">{{ section.settings.stat_2_label }}</span>
          </div>
          <div class="stat-pill">
            <span class="stat-number">{{ section.settings.stat_3_num }}</span>
            <span class="stat-label">{{ section.settings.stat_3_label }}</span>
          </div>
        </div>

        <a href="#productSection" class="btn-secondary-link">{{ section.settings.cta_link_text }} →</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Folea Results Comparison",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before Image (Frizzy Hair)"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After Image (Glossy Smooth Hair)"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "CLINICALLY OBSERVED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Visible Results From Pump 01."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Description",
      "default": "Say goodbye to dry, brittle, unmanageable hair. One pump transforms texture instantly without weighing hair down."
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "97%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Reported instant frizz reduction"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "94%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Noticed mirror-like shine without greasiness"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "3x"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Faster detangling & blowout time"
    },
    {
      "type": "text",
      "id": "cta_link_text",
      "label": "Link Text",
      "default": "Claim Your Bottle Today"
    }
  ],
  "presets": [
    {
      "name": "Folea Results Comparison"
    }
  ]
}
{% endschema %}

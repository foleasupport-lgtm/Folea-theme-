<section class="formula-shipping-section">
  <div class="container">
    <div class="formula-grid">
      <div class="info-box formula-box">
        <div class="info-tag">{{ section.settings.formula_tag }}</div>
        <h3>{{ section.settings.formula_title }}</h3>
        <ul class="ingredients-list">
          <li>
            <strong>{{ section.settings.ing_1_name | default: 'Moroccan Organic Argan Oil:' }}</strong> {{ section.settings.ing_1_desc | default: 'Penetrates hair shafts to soften rough cuticles and seal split ends.' }}
          </li>
          <li>
            <strong>{{ section.settings.ing_2_name | default: 'Golden Jojoba Seed Oil:' }}</strong> {{ section.settings.ing_2_desc | default: 'Mimics natural scalp lipids to restore elasticity without heaviness.' }}
          </li>
          <li>
            <strong>{{ section.settings.ing_3_name | default: 'Hydrolyzed Silk Keratin:' }}</strong> {{ section.settings.ing_3_desc | default: 'Strengthens weak strands exposed to dyes and environmental pollutants.' }}
          </li>
          <li>
            <strong>{{ section.settings.ing_4_name | default: 'Pure Alpha-Tocopherol (Vitamin E):' }}</strong> {{ section.settings.ing_4_desc | default: 'Powerful antioxidant defense against UV and sun damage.' }}
          </li>
        </ul>
      </div>

      <div class="info-box shipping-box">
        <div class="info-tag">{{ section.settings.shipping_tag }}</div>
        <h3>{{ section.settings.shipping_title }}</h3>
        <div class="shipping-steps">
          <div class="ship-row">
            <div class="ship-icon">{{ section.settings.ship_1_icon | default: '📦' }}</div>
            <div>
              <strong>{{ section.settings.ship_1_title | default: 'Same-Day Dispatch:' }}</strong> {{ section.settings.ship_1_desc | default: 'Orders placed before 4 PM are packed and handed over to courier on the same day.' }}
            </div>
          </div>
          <div class="ship-row">
            <div class="ship-icon">{{ section.settings.ship_2_icon | default: '🚚' }}</div>
            <div>
              <strong>{{ section.settings.ship_2_title | default: 'Courier Partners:' }}</strong> {{ section.settings.ship_2_desc | default: 'TCS, Leopards, and Trax with live SMS tracking sent to your WhatsApp.' }}
            </div>
          </div>
          <div class="ship-row">
            <div class="ship-icon">{{ section.settings.ship_3_icon | default: '💵' }}</div>
            <div>
              <strong>{{ section.settings.ship_3_title | default: 'Cash on Delivery:' }}</strong> {{ section.settings.ship_3_desc | default: 'Inspect the parcel upon arrival and hand over cash to the courier rider.' }}
            </div>
          </div>
          <div class="ship-row">
            <div class="ship-icon">{{ section.settings.ship_4_icon | default: '🔄' }}</div>
            <div>
              <strong>{{ section.settings.ship_4_title | default: '7 Days Checking Warranty:' }}</strong> {{ section.settings.ship_4_desc | default: 'Any damage or defect is replaced immediately with 0 extra charges.' }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <button class="nav-toggle" aria-label="Open Navigation Menu" id="menuBtn">
      <span></span>
      <span></span>
    </button>

    <a href="{{ routes.root_url }}" class="brand-logo" aria-label="Folea Home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto;">
      {%- else -%}
        <span class="logo-text">fole<span class="accent-a">a<span class="accent-mark">&#769;</span></span></span>
      {%- endif -%}
    </a>

    <div class="header-actions">
      <button class="cart-btn" id="cartBtn" aria-label="Open Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Slide-out Mobile Navigation Drawer -->
<div class="nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="drawer-backdrop" id="mobileNavBackdrop"></div>
  <div class="drawer-panel">
    <div class="drawer-header">
      <div class="brand-logo">
        <span class="logo-text">fole<span class="accent-a">a<span class="accent-mark">&#769;</span></span></span>
      </div>
      <button class="drawer-close" id="closeMenuBtn" aria-label="Close Menu">&times;</button>
    </div>

    <nav class="drawer-nav">
      <ul>
        <li><a href="#productSection" class="nav-link">Order Serum (COD)</a></li>
        <li><a href="#benefitsSection" class="nav-link">Why Hair Loves Folea</a></li>
        <li><a href="#resultsSection" class="nav-link">Before & After Results</a></li>
        <li><a href="#videoReviewsSection" class="nav-link">Video Reviews</a></li>
        <li><a href="#reviewsSection" class="nav-link">Customer Feedback</a></li>
        <li><a href="#faqSection" class="nav-link">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="drawer-footer">
      <div class="drawer-badge">🇵🇰 Nationwide Express Delivery</div>
      <p class="drawer-info">Questions? Contact our team on WhatsApp:</p>
      <a href="https://wa.me/923000000000" target="_blank" class="drawer-whatsapp-btn">
        <span>💬 Chat on WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<!-- Slide-out Mini Cart Drawer -->
<div class="cart-drawer" id="cartDrawer" aria-hidden="true">
  <div class="drawer-backdrop" id="cartDrawerBackdrop"></div>
  <div class="drawer-panel">
    <div class="drawer-header">
      <h3>Your Bag (<span id="drawerCartCount">{{ cart.item_count }}</span>)</h3>
      <button class="drawer-close" id="closeCartBtn" aria-label="Close Cart">&times;</button>
    </div>

    <div class="drawer-body" id="cartDrawerBody">
      {%- if cart.item_count > 0 -%}
        <div class="cart-items-list" id="cartItemsList">
          {%- for item in cart.items -%}
            <div class="drawer-cart-item">
              <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}">
              <div class="item-details">
                <h4>{{ item.product.title }}</h4>
                <div class="item-price">{{ item.final_line_price | money }}</div>
                <div class="item-qty">Qty: {{ item.quantity }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="cart-empty-state" id="emptyCartMessage">
          <p>Your bag is empty.</p>
          <a href="#productSection" class="btn-primary-small" id="shopNowCartBtn">Order Folea Serum</a>
        </div>
      {%- endif -%}
    </div>

    <div class="drawer-footer cart-footer-box">
      <div class="cart-subtotal-row">
        <span>Subtotal</span>
        <strong id="drawerCartTotal">{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-shipping-note">Free Delivery across Pakistan on bundle orders!</p>
      <a href="/checkout" class="btn-checkout pulse-glow">
        <span>PROCEED TO CHECKOUT (COD)</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Folea Header & Menus",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Height",
      "default": 36
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Logo Tagline",
      "default": "THOUGHTFULLY FORMULATED. BEAUTIFULLY SIMPLE."
    }
  ]
}
{% endschema %}

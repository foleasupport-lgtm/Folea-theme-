<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <button class="nav-toggle" aria-label="Open Navigation Menu" id="menuBtn">
      <span></span>
      <span></span>
    </button>

    <a href="{{ routes.root_url }}" class="brand-logo" aria-label="Folea Home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto;">
      {%- else -%}
        <img src="{{ 'folea-logo.png' | asset_url }}" alt="folea'" class="folea-brand-img" width="124" height="34" loading="eager">
      {%- endif -%}
    </a>

    <div class="header-actions">
      <button class="cart-btn" id="cartBtn" aria-label="Open Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Slide-out Mobile Navigation Drawer -->
<div class="nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="drawer-backdrop" id="mobileNavBackdrop"></div>
  <div class="drawer-panel">
    <div class="drawer-header">
      <div class="brand-logo">
        <img src="{{ 'folea-logo.png' | asset_url }}" alt="folea'" class="folea-brand-img" width="112" height="31" loading="lazy">
      </div>
      <button class="drawer-close" id="closeMenuBtn" aria-label="Close Menu">&times;</button>
    </div>

    <nav class="drawer-nav">
      <ul>
        <li><a href="#productSection" class="nav-link">Order Serum (COD)</a></li>
        <li><a href="#benefitsSection" class="nav-link">Why Hair Loves Folea</a></li>
        <li><a href="#resultsSection" class="nav-link">Before & After Results</a></li>
        <li><a href="#videoReviewsSection" class="nav-link">Video Reviews</a></li>
        <li><a href="#reviewsSection" class="nav-link">Customer Feedback</a></li>
        <li><a href="#faqSection" class="nav-link">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="drawer-footer">
      <div class="drawer-badge">🇵🇰 Nationwide Express Delivery</div>
      
      <!-- WhatsApp Live Typing Status Indicator -->
      <div class="drawer-typing-status">
        <span class="online-beacon" aria-hidden="true"></span>
        <span class="typing-agent-name">Folea Support</span>
        <span class="typing-status-text">is typing</span>
        <span class="typing-wave-dots" aria-hidden="true">
          <span class="wave-dot"></span>
          <span class="wave-dot"></span>
          <span class="wave-dot"></span>
        </span>
      </div>

      <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '923000000000' | replace: '+', '' | replace: ' ', '' | replace: '-', '' }}" target="_blank" rel="noopener noreferrer" class="drawer-whatsapp-btn wa-animated-btn">
        <div class="wa-btn-content">
          <svg class="wa-svg-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="wa-btn-label">Chat on WhatsApp</span>
          <span class="wa-inline-typing" aria-label="Typing indicator">
            <span class="dot d1"></span>
            <span class="dot d2"></span>
            <span class="dot d3"></span>
          </span>
        </div>
        <span class="wa-wave-pulse" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</div>

<!-- Slide-out Mini Cart Drawer -->
<div class="cart-drawer" id="cartDrawer" aria-hidden="true">
  <div class="drawer-backdrop" id="cartDrawerBackdrop"></div>
  <div class="drawer-panel">
    <div class="drawer-header">
      <h3>Your Bag (<span id="drawerCartCount">{{ cart.item_count }}</span>)</h3>
      <button class="drawer-close" id="closeCartBtn" aria-label="Close Cart">&times;</button>
    </div>

    <div class="drawer-body" id="cartDrawerBody">
      {%- if cart.item_count > 0 -%}
        <div class="cart-items-list" id="cartItemsList">
          {%- for item in cart.items -%}
            <div class="drawer-cart-item">
              <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}">
              <div class="item-details">
                <h4>{{ item.product.title }}</h4>
                <div class="item-price">{{ item.final_line_price | money }}</div>
                <div class="item-qty">Qty: {{ item.quantity }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="cart-empty-state" id="emptyCartMessage">
          <p>Your bag is empty.</p>
          <a href="#productSection" class="btn-primary-small" id="shopNowCartBtn">Order Folea Serum</a>
        </div>
      {%- endif -%}
    </div>

    <div class="drawer-footer cart-footer-box">
      <div class="cart-subtotal-row">
        <span>Subtotal</span>
        <strong id="drawerCartTotal">{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-shipping-note">Free Delivery across Pakistan on bundle orders!</p>
      <a href="/checkout" class="btn-checkout pulse-glow">
        <span>PROCEED TO CHECKOUT (COD)</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Folea Header & Menus",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Height",
      "default": 36
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Logo Tagline",
      "default": "THOUGHTFULLY FORMULATED. BEAUTIFULLY SIMPLE."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Contact Number",
      "default": "923000000000",
      "info": "Format: 923001234567 (with country code, no + or spaces)"
    }
  ]
}
{% endschema %}

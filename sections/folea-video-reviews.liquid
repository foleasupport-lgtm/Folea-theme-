            "caption": "Look at this shine! Blowouts last 3 full days now."
          }
        },
        {
          "type": "video_card",
          "settings": {
            "author_name": "Ayesha M.",
            "author_city": "Karachi • Verified Buyer",
            "caption": "Best serum in Pakistan right now. Bottle looks so aesthetic."
          }
        },
        {
          "type": "video_card",
          "settings": {
            "author_name": "Dr. Sana R.",
            "author_city": "Rawalpindi • Verified Buyer",
            "caption": "Clean ingredients, no alcohol burn or greasy buildup."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="ugc-video-section">
  <div class="container">
    <div class="section-heading text-center">
      <span class="sub-heading">{{ section.settings.sub_heading }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-desc">{{ section.settings.desc }}</p>
    </div>

    <div class="video-carousel-wrapper">
      <div class="video-carousel" id="videoCarousel">
        {%- for block in section.blocks -%}
          <div class="ugc-card" {{ block.shopify_attributes }}>
            <div class="ugc-thumb" data-ugc-id="{{ block.id }}">
              {%- if block.settings.video != blank -%}
                <video class="ugc-native-video" 
                       playsinline 
                       webkit-playsinline 
                       preload="metadata" 
                       loop 
                       poster="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% elsif block.settings.video.preview_image != blank %}{{ block.settings.video.preview_image | image_url: width: 600 }}{% endif %}">
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif block.settings.video_url != blank -%}
                <video class="ugc-native-video" 
                       playsinline 
                       webkit-playsinline 
                       preload="metadata" 
                       loop 
                       src="{{ block.settings.video_url }}" 
                       poster="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% endif %}">
                </video>
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.author_name }}" class="ugc-poster-img">
              {%- else -%}
                <img src="{{ 'folea-ugc-1.jpg' | asset_url }}" alt="Review Video" class="ugc-poster-img">
              {%- endif -%}

              <!-- Sound Toggle Button -->
              <button type="button" class="ugc-sound-toggle" aria-label="Toggle Sound" title="Sound">
                <span class="sound-icon-unmuted">🔊</span>
                <span class="sound-icon-muted" style="display:none;">🔇</span>
              </button>

              <!-- Play / Pause Overlay Icon -->
              <div class="ugc-play-overlay">
                <span class="play-icon">▶</span>
                <span class="pause-icon" style="display:none;">❚❚</span>
              </div>

              <!-- Real-time Progress Bar -->
              <div class="ugc-progress-track">
                <div class="ugc-progress-bar"></div>
              </div>

              <!-- Author Badge -->
              <div class="ugc-author-badge">
                <div class="author-name">{{ block.settings.author_name }} <span class="badge-check">✓</span></div>
                <div class="author-city">{{ block.settings.author_city }}</div>
              </div>
            </div>
            <div class="ugc-caption">
              <div class="ugc-stars">★★★★★</div>
              <p>"{{ block.settings.caption }}"</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Folea 9:16 Video Reviews",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "REAL EXPERIENCES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Video Reactions"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "See real Pakistani women test Folea Anti-Frizz Serum on live camera."
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "9:16 Video Review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video (Upload directly)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Or Shopify MP4 URL (Content > Files link)",
          "info": "Shopify Admin > Content > Files se direct MP4 link yahan paste kar sakte hain"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poster / Cover Image (Optional)"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Zoya K."
        },
        {
          "type": "text",
          "id": "author_city",
          "label": "City & Status",
          "default": "Lahore • Verified Buyer"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Review Quote",
          "default": "My holy grail for humidity. Not sticky at all!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folea 9:16 Video Reviews",
      "blocks": [
        {
          "type": "video_card",
          "settings": {
            "author_name": "Zoya K.",
            "author_city": "Lahore • Verified Buyer",

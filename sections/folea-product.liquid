{%- assign product = all_products[section.settings.featured_product] -%}
{%- if product == blank or product.empty? -%}
  {%- assign product = all_products['folea-anti-frizz-hair-serum'] -%}
{%- endif -%}
{%- if product == blank or product.empty? -%}
  {%- assign product = all_products['anti-frizz-hair-serum'] -%}
{%- endif -%}
{%- if product == blank or product.empty? -%}
  {%- assign product = all_products['folea-serum'] -%}
{%- endif -%}
{%- if product == blank or product.empty? -%}
  {%- assign product = collections['all'].products.first -%}
{%- endif -%}
{%- if product == blank or product.empty? -%}
  {%- assign product = collections.all.products.first -%}
{%- endif -%}
{%- if product == blank or product.empty? -%}
  {%- for collection in collections -%}
    {%- if collection.products.first != blank and product == blank -%}
      {%- assign product = collection.products.first -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign manual_id = section.settings.manual_variant_id | strip -%}
{%- assign resolved_variant_id = current_variant.id -%}
{%- if resolved_variant_id == blank and manual_id != blank -%}
  {%- assign resolved_variant_id = manual_id -%}
{%- endif -%}

{%- assign v1 = product.variants[0] | default: current_variant -%}
{%- assign v2 = product.variants[1] | default: v1 -%}
{%- assign v3 = product.variants[2] | default: v1 -%}

{%- assign v1_id = v1.id -%}
{%- assign v2_id = v2.id -%}
{%- assign v3_id = v3.id -%}

{%- if section.settings.bundle_1_variant_id != blank -%}
  {%- assign v1_id = section.settings.bundle_1_variant_id | strip -%}
{%- endif -%}
{%- if section.settings.bundle_2_variant_id != blank -%}
  {%- assign v2_id = section.settings.bundle_2_variant_id | strip -%}
{%- endif -%}
{%- if section.settings.bundle_3_variant_id != blank -%}
  {%- assign v3_id = section.settings.bundle_3_variant_id | strip -%}
{%- endif -%}

{%- assign has_bundle_variants = false -%}
{%- if product.variants.size >= 3 or section.settings.bundle_2_variant_id != blank or section.settings.bundle_3_variant_id != blank -%}
  {%- assign has_bundle_variants = true -%}
{%- endif -%}

<main class="product-section" id="productSection">
  <div class="container">
    <div class="product-grid">
      
      <!-- Left: Product Media Gallery -->
      <div class="product-gallery">
        <div class="main-image-wrapper">
          <span class="sale-badge">{{ section.settings.sale_badge_text }}</span>
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" id="mainProductImg" class="main-product-img">
          {%- elsif section.settings.custom_image_1 != blank -%}
            <img src="{{ section.settings.custom_image_1 | image_url: width: 800 }}" alt="Folea Bottle" id="mainProductImg" class="main-product-img">
          {%- else -%}
            <img src="{{ 'folea-bottle.jpg' | asset_url }}" alt="Folea Anti-Frizz Hair Serum" id="mainProductImg" class="main-product-img">
          {%- endif -%}
        </div>

        <div class="thumb-strip">
          <button type="button" class="thumb-btn active" data-src="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 }}{% elsif section.settings.custom_image_1 != blank %}{{ section.settings.custom_image_1 | image_url: width: 800 }}{% else %}{{ 'folea-bottle.jpg' | asset_url }}{% endif %}">
            <img src="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 160 }}{% elsif section.settings.custom_image_1 != blank %}{{ section.settings.custom_image_1 | image_url: width: 160 }}{% else %}{{ 'folea-bottle.jpg' | asset_url }}{% endif %}" alt="Front Bottle">
          </button>
          <button type="button" class="thumb-btn" data-src="{% if product.images[1] != blank %}{{ product.images[1] | image_url: width: 800 }}{% elsif section.settings.custom_image_2 != blank %}{{ section.settings.custom_image_2 | image_url: width: 800 }}{% else %}{{ 'folea-texture.jpg' | asset_url }}{% endif %}">
            <img src="{% if product.images[1] != blank %}{{ product.images[1] | image_url: width: 160 }}{% elsif section.settings.custom_image_2 != blank %}{{ section.settings.custom_image_2 | image_url: width: 160 }}{% else %}{{ 'folea-texture.jpg' | asset_url }}{% endif %}" alt="Texture Detail">
          </button>
          <button type="button" class="thumb-btn" data-src="{% if product.images[2] != blank %}{{ product.images[2] | image_url: width: 800 }}{% elsif section.settings.custom_image_3 != blank %}{{ section.settings.custom_image_3 | image_url: width: 800 }}{% else %}{{ 'folea-results.jpg' | asset_url }}{% endif %}">
            <img src="{% if product.images[2] != blank %}{{ product.images[2] | image_url: width: 160 }}{% elsif section.settings.custom_image_3 != blank %}{{ section.settings.custom_image_3 | image_url: width: 160 }}{% else %}{{ 'folea-results.jpg' | asset_url }}{% endif %}" alt="Transformation">
          </button>
        </div>
      </div>

      <!-- Right: Product Buy Box & Backend Shopify Form -->
      <div class="product-info-box">
        <div class="rating-stars-row">
          <div class="stars">★★★★★</div>
          <span class="rating-text">{{ section.settings.rating_score }}</span>
          <span class="verified-count">({{ section.settings.rating_count }})</span>
        </div>

        <h2 class="product-title">{% if product.title != blank %}{{ product.title }}{% else %}{{ section.settings.product_title }}{% endif %}</h2>
        <div class="product-meta">{{ section.settings.product_meta }}</div>

        <div class="price-row">
          <span class="current-price" id="displayPrice">
            {%- if product.variants.size >= 1 and v1.price -%}
              {{ v1.price | money }}
            {%- else -%}
              {{ section.settings.bundle_1_price }}
            {%- endif -%}
          </span>
          <span class="compare-price" id="displayComparePrice">
            {%- if product.variants.size >= 1 and v1.compare_at_price -%}
              {{ v1.compare_at_price | money }}
            {%- else -%}
              {{ section.settings.bundle_1_compare }}
            {%- endif -%}
          </span>
          <span class="discount-pill" id="displayDiscount">{{ section.settings.bundle_1_save }}</span>
        </div>

        <div class="urgency-banner">
          <span class="flame-icon">🔥</span>
          <span>High Demand: Only <strong class="pulse-num">{{ section.settings.stock_left }} bottles</strong> left in this batch.</span>
        </div>

        <!-- REAL SHOPIFY BACKEND FORM -->
        <form method="post" action="/cart/add" id="foleaProductForm" enctype="multipart/form-data" class="folea-native-form">
          <input type="hidden" name="id" id="foleaVariantId" value="{{ v1_id }}">
          <input type="hidden" name="quantity" id="foleaRealQuantity" value="1">

          <!-- Bundle Selector (Synced with Shopify Quantity & Variants) -->
          <div class="bundle-selector">
            <div class="bundle-header">SELECT SPECIAL DEAL (FREE SHIPPING ON 2+):</div>
            
            <div class="bundle-card selected" data-bundle="1" data-variant-id="{{ v1_id }}" data-bottles="1" data-qty="1" data-price="{% if product.variants.size >= 1 and v1.price %}{{ v1.price | money }}{% else %}{{ section.settings.bundle_1_price }}{% endif %}" data-compare="{% if product.variants.size >= 1 and v1.compare_at_price %}{{ v1.compare_at_price | money }}{% else %}{{ section.settings.bundle_1_compare }}{% endif %}" data-savings="{{ section.settings.bundle_1_save }}" data-discount="{{ section.settings.bundle_1_discount_code | strip }}">
              <div class="bundle-radio"><span class="radio-dot"></span></div>
              <div class="bundle-info">
                <div class="bundle-title-row">
                  <span class="bundle-title">{{ section.settings.bundle_1_title }}</span>
                </div>
                {%- if section.settings.bundle_1_sub != blank -%}
                  <div class="bundle-sub">{{ section.settings.bundle_1_sub }}</div>
                {%- endif -%}
              </div>
              <div class="bundle-pricing">
                <div class="bundle-p">{% if product.variants.size >= 1 and v1.price %}{{ v1.price | money }}{% else %}{{ section.settings.bundle_1_price }}{% endif %}</div>
                <div class="bundle-was">{% if product.variants.size >= 1 and v1.compare_at_price %}{{ v1.compare_at_price | money }}{% else %}{{ section.settings.bundle_1_compare }}{% endif %}</div>
              </div>
            </div>

            <div class="bundle-card" data-bundle="2" data-variant-id="{{ v2_id }}" data-bottles="2" data-qty="{% if has_bundle_variants %}1{% else %}2{% endif %}" data-price="{% if product.variants.size >= 2 and v2.price %}{{ v2.price | money }}{% else %}{{ section.settings.bundle_2_price }}{% endif %}" data-compare="{% if product.variants.size >= 2 and v2.compare_at_price %}{{ v2.compare_at_price | money }}{% else %}{{ section.settings.bundle_2_compare }}{% endif %}" data-savings="{{ section.settings.bundle_2_save }}" data-discount="{{ section.settings.bundle_2_discount_code | strip }}">
              <div class="bundle-radio"><span class="radio-dot"></span></div>
              <div class="bundle-info">
                <div class="bundle-title-row">
                  <span class="bundle-title">{{ section.settings.bundle_2_title }}</span>
                  <span class="bundle-badge-inline">BEST DEAL</span>
                </div>
                {%- if section.settings.bundle_2_sub != blank -%}
                  <div class="bundle-sub">{{ section.settings.bundle_2_sub }}</div>
                {%- endif -%}
              </div>
              <div class="bundle-pricing">
                <div class="bundle-p">{% if product.variants.size >= 2 and v2.price %}{{ v2.price | money }}{% else %}{{ section.settings.bundle_2_price }}{% endif %}</div>
                <div class="bundle-was">{% if product.variants.size >= 2 and v2.compare_at_price %}{{ v2.compare_at_price | money }}{% else %}{{ section.settings.bundle_2_compare }}{% endif %}</div>
              </div>
            </div>

            <div class="bundle-card" data-bundle="3" data-variant-id="{{ v3_id }}" data-bottles="3" data-qty="{% if has_bundle_variants %}1{% else %}3{% endif %}" data-price="{% if product.variants.size >= 3 and v3.price %}{{ v3.price | money }}{% else %}{{ section.settings.bundle_3_price }}{% endif %}" data-compare="{% if product.variants.size >= 3 and v3.compare_at_price %}{{ v3.compare_at_price | money }}{% else %}{{ section.settings.bundle_3_compare }}{% endif %}" data-savings="{{ section.settings.bundle_3_save }}" data-discount="{{ section.settings.bundle_3_discount_code | strip }}">
              <div class="bundle-radio"><span class="radio-dot"></span></div>
              <div class="bundle-info">
                <div class="bundle-title-row">
                  <span class="bundle-title">{{ section.settings.bundle_3_title }}</span>
                  <span class="bundle-badge-inline family">SAVE MAX</span>
                </div>
                {%- if section.settings.bundle_3_sub != blank -%}
                  <div class="bundle-sub">{{ section.settings.bundle_3_sub }}</div>
                {%- endif -%}
              </div>
              <div class="bundle-pricing">
                <div class="bundle-p">{% if product.variants.size >= 3 and v3.price %}{{ v3.price | money }}{% else %}{{ section.settings.bundle_3_price }}{% endif %}</div>
                <div class="bundle-was">{% if product.variants.size >= 3 and v3.compare_at_price %}{{ v3.compare_at_price | money }}{% else %}{{ section.settings.bundle_3_compare }}{% endif %}</div>
              </div>
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="qty-and-action-row">
            <span class="qty-label">Quantity:</span>
            <div class="qty-control">
              <button type="button" class="qty-btn" id="qtyMinus" aria-label="Decrease quantity">−</button>
              <input type="number" id="qtyInput" value="1" min="1" max="99" aria-label="Quantity">
              <button type="button" class="qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <!-- CTA Buttons Row: Direct COD Checkout + Add to Cart -->
          <div class="cta-actions-group">
            <button type="button" class="primary-buy-btn pulse-glow" id="orderNowBtn">
              <div class="btn-main-text">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <span id="btnTextLabel">{{ section.settings.cta_button_text }}</span>
              </div>
              <span class="btn-subtext">{{ section.settings.cta_subtext }}</span>
            </button>

            <button type="button" class="secondary-cart-btn" id="addToCartBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>ADD TO BAG</span>
            </button>
          </div>
        </form>

        <script id="foleaProductCatalog" type="application/json">
        {
          "hasProduct": {% if product != blank and product.empty? == false and current_variant != blank %}true{% else %}false{% endif %},
          "productId": {{ product.id | json }},
          "defaultVariantId": {{ resolved_variant_id | json }},
          "variants": [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id }},
                "title": {{ v.title | json }},
                "price": {{ v.price }},
                "available": {{ v.available | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
        </script>

        <!-- Pakistani Trust Badges -->
        <div class="trust-grid">
          <div class="trust-item">
            <div class="trust-icon">🚚</div>
            <div class="trust-title">Fast Delivery</div>
            <div class="trust-desc">2-4 Days (TCS & Leopards)</div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">💵</div>
            <div class="trust-title">Pay On Delivery</div>
            <div class="trust-desc">Cash On Delivery in all cities</div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">🛡️</div>
            <div class="trust-title">7 Days Warranty</div>
            <div class="trust-desc">Hassle-free replacement</div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">🌿</div>
            <div class="trust-title">100% Halal</div>
            <div class="trust-desc">No Parabens or Alcohol</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<!-- Sticky Mobile Bottom Bar -->
<div class="sticky-mobile-bar" id="stickyMobileBar">
  <div class="sticky-inner">
    <div class="sticky-thumb-info">
      <img src="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 100 }}{% elsif section.settings.custom_image_1 != blank %}{{ section.settings.custom_image_1 | image_url: width: 100 }}{% else %}{{ 'folea-bottle.jpg' | asset_url }}{% endif %}" alt="Folea Thumbnail">
      <div>
        <div class="sticky-title">Folea Serum</div>
        <div class="sticky-price" id="stickyPrice">{{ section.settings.bundle_1_price }}</div>
      </div>
    </div>
    <button type="button" class="sticky-action-btn pulse-glow" id="stickyOrderBtn">
      <span>ORDER COD</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>
</div>

<!-- Added to Cart Toast Notification -->
<div class="success-toast" id="cartSuccessToast">
  <div class="toast-icon">✓</div>
  <div>
    <h4 id="toastTitle">Item Added to Bag!</h4>
    <p id="toastMessage">Folea Serum was successfully added to your cart.</p>
  </div>
</div>


<style>
  /* Critical immediate WebKit / Safari media control suppression */
  #heroBgVideo {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }
  #heroBgVideo.is-playing,
  #heroBgVideo.is-ready {
    opacity: 1 !important;
  }
  #heroBgVideo::-webkit-media-controls {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  #heroBgVideo::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  #heroBgVideo::-webkit-media-controls-play-button {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  #heroBgVideo::-webkit-media-controls-panel {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  video::-webkit-media-controls {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<section class="hero-video-section">
  <div class="video-container" style="background: #0D0C0B;">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: false, muted: true, controls: false, playsinline: true, class: 'bg-video', id: 'heroBgVideo' }}
    {%- elsif section.settings.video_url != blank -%}
      <video class="bg-video" id="heroBgVideo" autoplay muted="muted" playsinline webkit-playsinline preload="auto" disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback" tabindex="-1">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      <video class="bg-video" id="heroBgVideo" autoplay muted="muted" playsinline webkit-playsinline preload="auto" disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback" tabindex="-1">
        <source src="{{ 'folea-hero-video.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}

    <div class="video-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    
    <div class="hero-content">
      {%- if section.settings.badge != blank -%}
        <div class="hero-badge">{{ section.settings.badge }}</div>
      {%- endif -%}
      <h1 class="hero-title">{{ section.settings.title }}</h1>
      <p class="hero-tagline">{{ section.settings.subtitle }}</p>
      {%- if section.settings.show_scroll_btn -%}
        <a href="#productSection" class="hero-scroll-btn">
          <span>{{ section.settings.scroll_btn_text }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initHeroVideo() {
      var heroVideo = document.getElementById('heroBgVideo');
      if (!heroVideo) return;
      heroVideo.muted = true;
      heroVideo.defaultMuted = true;
      heroVideo.playsInline = true;
      heroVideo.loop = false;
      heroVideo.removeAttribute('loop');
      heroVideo.setAttribute('playsinline', '');
      heroVideo.setAttribute('webkit-playsinline', '');

      var revealVideo = function() {
        heroVideo.classList.add('is-playing');
      };

      // Freeze on final frame (Folea bottle and branding)
      var freezeOnFinalFrame = function() {
        heroVideo.pause();
        if (heroVideo.duration && !isNaN(heroVideo.duration)) {
          heroVideo.currentTime = Math.max(0, heroVideo.duration - 0.05);
        }
      };

      heroVideo.addEventListener('ended', freezeOnFinalFrame);
      heroVideo.addEventListener('playing', revealVideo);
      heroVideo.addEventListener('timeupdate', function() {
        if (heroVideo.currentTime > 0.05) {
          revealVideo();
        }
        if (heroVideo.duration && heroVideo.currentTime >= heroVideo.duration - 0.1) {
          freezeOnFinalFrame();
        }
      });

      var playVideo = function() {
        heroVideo.muted = true;
        heroVideo.defaultMuted = true;
        var promise = heroVideo.play();
        if (promise !== undefined) {
          promise.then(function() {
            revealVideo();
          }).catch(function() {
            // Handled via user tap unlock
          });
        }
      };

      heroVideo.addEventListener('loadedmetadata', playVideo);
      heroVideo.addEventListener('canplay', playVideo);
      heroVideo.addEventListener('canplaythrough', playVideo);
      playVideo();

      // Fallback reveal in case browser delays playing event
      setTimeout(revealVideo, 400);

      // Immediate tap/touch unlock anywhere on the hero banner
      var heroSection = document.querySelector('.hero-video-section');
      if (heroSection) {
        ['touchstart', 'touchend', 'click'].forEach(function(evt) {
          heroSection.addEventListener(evt, function(e) {
            if (e.target && e.target.closest && e.target.closest('.hero-scroll-btn')) return;
            if (heroVideo.paused && !heroVideo.ended) {
              playVideo();
            }
          }, { passive: true });
        });
      }

      var unlockAutoplay = function() {
        if (heroVideo.paused && !heroVideo.ended) {
          playVideo();
        }
        ['touchstart', 'touchend', 'click'].forEach(function(evt) {
          document.removeEventListener(evt, unlockAutoplay);
        });
      };
      ['touchstart', 'touchend', 'click'].forEach(function(evt) {
        document.addEventListener(evt, unlockAutoplay, { passive: true, once: true });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroVideo);
    } else {
      initHeroVideo();
    }
  })();
</script>

{% schema %}
{
  "name": "Folea Hero Video Loop",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop Video Infinitely",
      "default": false,
      "info": "When unchecked, video plays through to the end and stays frozen on the final product frame."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Custom Video (Requires paid plan)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or External MP4 Link (CDN/Cloud)"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback Poster Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Video Dark Overlay Opacity",
      "default": 45
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Hero Badge",
      "default": "PAKISTAN'S #1 ANTI-FRIZZ FORMULA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "Effortless Frizz-Free Shine."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "Engineered for humid weather, hard water & daily heat styling."
    },
    {
      "type": "checkbox",
      "id": "show_scroll_btn",
      "label": "Show 'Explore Ritual' Link",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_btn_text",
      "label": "Scroll Link Text",
      "default": "Explore The Ritual"
    }
  ],
  "presets": [
    {
      "name": "Folea Hero Video Loop"
    }
  ]
}
{% endschema %}

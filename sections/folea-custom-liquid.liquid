<div class="folea-custom-liquid-section" style="{% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}background-color: {{ section.settings.bg_color }};{% endif %} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    <div class="custom-liquid-wrapper">
      {{ section.settings.custom_liquid }}
    </div>
  </div>
</div>

<style>
.folea-custom-liquid-section {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}
.custom-liquid-wrapper {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}
.custom-liquid-wrapper img,
.custom-liquid-wrapper video,
.custom-liquid-wrapper iframe {
  max-width: 100%;
  height: auto;
}
</style>

{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid / HTML Code",
      "info": "Paste any custom Liquid code, HTML, CSS, JavaScript, animation snippets, or app widgets here."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width (Edge to Edge)",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}

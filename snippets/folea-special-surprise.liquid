<!-- ===================================================================
     FOLEA SPECIAL SURPRISE: "I Love You Meri Bulbuli"
     Confetti Cracker Burst, Falling Rose Petals & Romantic Glass Card
     100% Modular & Isolated Snippet
     =================================================================== -->

<style>
  /* Confetti & Rose Petals Canvas Overlay */
  #bulbuliCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 99998;
    display: block;
  }

  /* Backdrop Overlay */
  .bulbuli-backdrop {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, rgba(30, 20, 18, 0.45) 0%, rgba(10, 8, 7, 0.75) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s;
  }

  .bulbuli-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  /* Glassmorphism Luxury Romantic Card */
  .bulbuli-card {
    position: relative;
    width: 100%;
    max-width: 410px;
    background: rgba(255, 252, 249, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1.5px solid rgba(214, 138, 110, 0.45);
    border-radius: 28px;
    padding: 38px 26px 30px;
    text-align: center;
    box-shadow: 0 24px 70px rgba(194, 109, 77, 0.28), 0 0 50px rgba(235, 115, 125, 0.2);
    transform: scale(0.85) translateY(24px);
    transition: transform 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;
  }

  .bulbuli-backdrop.active .bulbuli-card {
    transform: scale(1) translateY(0);
  }

  /* Subtle Rose-Gold Border Glow Sweep */
  .bulbuli-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 30px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(224, 132, 102, 0.7), rgba(255, 215, 180, 0.4), rgba(224, 132, 102, 0.8));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Close Button */
  .bulbuli-close-btn {
    position: absolute;
    top: 14px;
    right: 16px;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #6B5B52;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .bulbuli-close-btn:hover {
    background: rgba(194, 109, 77, 0.15);
    color: #C26D4D;
    transform: rotate(90deg);
  }

  /* Animated Pulsing Heart */
  .bulbuli-heart-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    background: linear-gradient(135deg, #FFEBE6 0%, #FFD5CC 100%);
    border-radius: 50%;
    margin-bottom: 18px;
    font-size: 32px;
    box-shadow: 0 8px 24px rgba(224, 110, 85, 0.35);
    animation: heartPulse 1.6s ease-in-out infinite;
    position: relative;
  }

  .bulbuli-heart-badge::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px dashed rgba(214, 120, 95, 0.5);
    animation: rotateDashed 12s linear infinite;
  }

  @keyframes heartPulse {
    0% { transform: scale(1); box-shadow: 0 8px 24px rgba(224, 110, 85, 0.35); }
    50% { transform: scale(1.1); box-shadow: 0 12px 32px rgba(224, 110, 85, 0.55); }
    100% { transform: scale(1); box-shadow: 0 8px 24px rgba(224, 110, 85, 0.35); }
  }

  @keyframes rotateDashed {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .bulbuli-tagline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #C26D4D;
    margin-bottom: 8px;
  }

  .bulbuli-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    color: #1A1817;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }

  .bulbuli-highlight {
    background: linear-gradient(135deg, #C26D4D 0%, #D45B6A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .bulbuli-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #6E6660;
    margin-bottom: 22px;
    padding: 0 8px;
  }

  .bulbuli-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #D69680;
    font-size: 12px;
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .bulbuli-divider::before,
  .bulbuli-divider::after {
    content: '';
    height: 1px;
    width: 38px;
    background: rgba(214, 150, 128, 0.4);
  }

  /* Continue / Explore Button */
  .bulbuli-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: linear-gradient(135deg, #1C1A19 0%, #2E2825 100%);
    color: #FFFFFF;
    border: none;
    border-radius: 40px;
    padding: 13px 22px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(28, 26, 25, 0.25);
    transition: all 0.25s ease;
  }

  .bulbuli-action-btn:hover {
    background: #000000;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(28, 26, 25, 0.35);
  }

  /* Replay Floating Heart Button */
  .bulbuli-replay-btn {
    position: fixed;
    bottom: 84px;
    right: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(214, 138, 110, 0.45);
    box-shadow: 0 6px 20px rgba(194, 109, 77, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    z-index: 890;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    animation: heartPulse 2.8s ease-in-out infinite;
  }

  .bulbuli-replay-btn:hover {
    transform: scale(1.15);
  }

  @media (max-width: 480px) {
    .bulbuli-card {
      padding: 32px 20px 24px;
      border-radius: 24px;
    }
    .bulbuli-title {
      font-size: 23px;
    }
    .bulbuli-desc {
      font-size: 12.5px;
    }
    .bulbuli-heart-badge {
      width: 58px;
      height: 58px;
      font-size: 28px;
      margin-bottom: 14px;
    }
  }
</style>

<!-- Canvas for Cracker Confetti & Rose Petals -->
<canvas id="bulbuliCanvas"></canvas>

<!-- Romantic Message Modal -->
<div class="bulbuli-backdrop" id="bulbuliBackdrop" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="bulbuli-card">
    <button type="button" class="bulbuli-close-btn" id="bulbuliCloseBtn" aria-label="Close Surprise">&times;</button>
    
    <div class="bulbuli-heart-badge">❤️</div>
    <div class="bulbuli-tagline">A SPECIAL SURPRISE FOR YOU</div>
    
    <h2 class="bulbuli-title">
      I Love You <span class="bulbuli-highlight">Meri Bulbuli</span>
    </h2>

    <div class="bulbuli-divider">✦ ─── 💖 ─── ✦</div>

    <p class="bulbuli-desc">
      You make every single moment brighter, softer & more beautiful. Here is to your endless shine! ✨
    </p>

    <button type="button" class="bulbuli-action-btn" id="bulbuliExploreBtn">
      <span>Explore Folea Together ✨</span>
    </button>
  </div>
</div>

<!-- Replay Button (Allows replaying anytime) -->
<button type="button" class="bulbuli-replay-btn" id="bulbuliReplayBtn" title="Replay Surprise" style="display: none;">
  💖
</button>

<script>
  (function() {
    // ----------------------------------------------------
    // Confetti & Rose Petals Physics Engine
    // ----------------------------------------------------
    var canvas = document.getElementById('bulbuliCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var particles = [];
    var animationFrameId = null;
    var hasTriggered = false;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Color palettes
    var confettiColors = [
      '#C26D4D', '#D97559', '#E89078', '#F5D3C8', '#D45B6A',
      '#FFD700', '#F0C27B', '#FFFFFF', '#E63946', '#FFB703'
    ];
    var petalColors = [
      { fill: '#C92A42', shadow: '#8B1528' },
      { fill: '#D6334D', shadow: '#9E1C31' },
      { fill: '#B51731', shadow: '#7A0C1E' },
      { fill: '#E64C65', shadow: '#A8253B' },
      { fill: '#ED6B82', shadow: '#C23D54' }
    ];

    // Particle Classes
    function ConfettiParticle(x, y) {
      this.type = 'confetti';
      this.x = x;
      this.y = y;
      var angle = Math.random() * Math.PI * 2;
      var speed = Math.random() * 12 + 4;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed - 6; // Initial upward burst
      this.color = confettiColors[Math.floor(Math.random() * confettiColors.length)];
      this.size = Math.random() * 7 + 4;
      this.rotation = Math.random() * 360;
      this.rotationSpeed = (Math.random() - 0.5) * 14;
      this.gravity = 0.28;
      this.drag = 0.95;
      this.opacity = 1;
      this.decay = Math.random() * 0.008 + 0.006;
    }

    function PetalParticle() {
      this.type = 'petal';
      this.x = Math.random() * canvas.width;
      this.y = -Math.random() * 120 - 20;
      this.vx = (Math.random() - 0.5) * 1.5;
      this.vy = Math.random() * 1.8 + 1.2;
      this.wobble = Math.random() * Math.PI * 2;
      this.wobbleSpeed = Math.random() * 0.04 + 0.02;
      this.size = Math.random() * 10 + 12;
      var colorObj = petalColors[Math.floor(Math.random() * petalColors.length)];
      this.color = colorObj.fill;
      this.shadow = colorObj.shadow;
      this.rotation = Math.random() * Math.PI * 2;
      this.rotationSpeed = (Math.random() - 0.5) * 0.03;
      this.opacity = 0.95;
      this.decay = 0.0015;
    }

    function StarParticle(x, y) {
      this.type = 'star';
      this.x = x;
      this.y = y;
      var angle = Math.random() * Math.PI * 2;
      var speed = Math.random() * 8 + 2;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed - 3;
      this.size = Math.random() * 3.5 + 2;
      this.opacity = 1;
      this.decay = Math.random() * 0.015 + 0.01;
    }

    function launchCelebration() {
      resizeCanvas();
      var centerX = canvas.width / 2;
      var centerY = canvas.height * 0.45;

      // 1. Double Cracker Burst from sides & center
      for (var i = 0; i < 90; i++) {
        particles.push(new ConfettiParticle(centerX, centerY));
      }
      for (var j = 0; j < 45; j++) {
        particles.push(new ConfettiParticle(canvas.width * 0.25, centerY + 50));
        particles.push(new ConfettiParticle(canvas.width * 0.75, centerY + 50));
      }

      // 2. Golden Twinkle Stars
      for (var s = 0; s < 50; s++) {
        particles.push(new StarParticle(centerX, centerY));
      }

      // 3. Floating Rose Petals Stream
      for (var p = 0; p < 45; p++) {
        particles.push(new PetalParticle());
      }

      if (!animationFrameId) {
        animateParticles();
      }
    }

    // Continuous rose petal spawner during celebration
    var petalInterval = null;
    function startPetalStream() {
      if (petalInterval) clearInterval(petalInterval);
      var count = 0;
      petalInterval = setInterval(function() {
        if (count > 25) {
          clearInterval(petalInterval);
          return;
        }
        for (var i = 0; i < 3; i++) {
          particles.push(new PetalParticle());
        }
        count++;
      }, 350);
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (var i = particles.length - 1; i >= 0; i--) {
        var p = particles[i];

        if (p.type === 'confetti') {
          p.vx *= p.drag;
          p.vy *= p.drag;
          p.vy += p.gravity;
          p.x += p.vx;
          p.y += p.vy;
          p.rotation += p.rotationSpeed;
          p.opacity -= p.decay;

          if (p.opacity <= 0 || p.y > canvas.height + 20) {
            particles.splice(i, 1);
            continue;
          }

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.globalAlpha = Math.max(0, p.opacity);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
          ctx.restore();
        } else if (p.type === 'star') {
          p.vx *= 0.94;
          p.vy *= 0.94;
          p.x += p.vx;
          p.y += p.vy;
          p.opacity -= p.decay;

          if (p.opacity <= 0) {
            particles.splice(i, 1);
            continue;
          }

          ctx.save();
          ctx.globalAlpha = Math.max(0, p.opacity);
          ctx.fillStyle = '#FFE082';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        } else if (p.type === 'petal') {
          p.wobble += p.wobbleSpeed;
          p.x += p.vx + Math.sin(p.wobble) * 1.4;
          p.y += p.vy;
          p.rotation += p.rotationSpeed;
          p.opacity -= p.decay;

          if (p.opacity <= 0 || p.y > canvas.height + 30) {
            particles.splice(i, 1);
            continue;
          }

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);
          ctx.globalAlpha = Math.max(0, p.opacity);

          // Draw realistic rose petal curved shape
          ctx.beginPath();
          ctx.moveTo(0, -p.size * 0.7);
          ctx.bezierCurveTo(p.size * 0.65, -p.size * 0.55, p.size * 0.65, p.size * 0.55, 0, p.size * 0.7);
          ctx.bezierCurveTo(-p.size * 0.65, p.size * 0.55, -p.size * 0.65, -p.size * 0.55, 0, -p.size * 0.7);
          ctx.fillStyle = p.color;
          ctx.fill();

          // Subtle petal fold highlight
          ctx.beginPath();
          ctx.moveTo(0, -p.size * 0.6);
          ctx.quadraticCurveTo(p.size * 0.25, 0, 0, p.size * 0.55);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.restore();
        }
      }

      if (particles.length > 0) {
        animationFrameId = requestAnimationFrame(animateParticles);
      } else {
        animationFrameId = null;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    // ----------------------------------------------------
    // Modal & Scroll Trigger Handlers
    // ----------------------------------------------------
    var modal = document.getElementById('bulbuliBackdrop');
    var closeBtn = document.getElementById('bulbuliCloseBtn');
    var exploreBtn = document.getElementById('bulbuliExploreBtn');
    var replayBtn = document.getElementById('bulbuliReplayBtn');

    function openSurprise() {
      if (modal) {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
      }
      launchCelebration();
      startPetalStream();
      if (replayBtn) replayBtn.style.display = 'flex';
    }

    function closeSurprise() {
      if (modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeSurprise);
    if (exploreBtn) exploreBtn.addEventListener('click', closeSurprise);
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeSurprise();
        }
      });
    }
    if (replayBtn) replayBtn.addEventListener('click', openSurprise);

    // Scroll Trigger: When visitor scrolls down from top banner to Folea bottle section
    function setupScrollTrigger() {
      var target = document.getElementById('productSection') || document.querySelector('.product-section');
      if (!target) return;

      var hasScrolledDown = false;
      function checkUserScroll() {
        if (window.scrollY > 120) {
          hasScrolledDown = true;
        }
      }
      window.addEventListener('scroll', checkUserScroll, { passive: true });

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          // MUST be intersecting AND visitor must have scrolled down from the top banner
          if (entry.isIntersecting && !hasTriggered && (hasScrolledDown || window.scrollY > 120)) {
            hasTriggered = true;
            window.removeEventListener('scroll', checkUserScroll);
            // Short pause so she sees the bottle first, then BAM celebration!
            setTimeout(openSurprise, 400);
            observer.disconnect();
          }
        });
      }, {
        threshold: 0.25
      });

      observer.observe(target);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupScrollTrigger);
    } else {
      setupScrollTrigger();
    }
  })();
</script>

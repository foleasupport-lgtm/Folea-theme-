<!doctype html>
<!-- folea-sync: 2026-10-25T21:20 -->
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#161514">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ 'folea-theme.css' | asset_url | stylesheet_tag }}
    <style>
      .thumb-strip:has(.thumb-btn:only-child),
      .thumb-strip:empty {
        display: none !important;
      }
      .thumb-btn {
        flex: 0 0 74px !important;
        width: 74px !important;
        height: 74px !important;
        max-width: 74px !important;
      }
      .sticky-mobile-bar {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 2147483647 !important;
        padding-bottom: max(18px, calc(10px + env(safe-area-inset-bottom, 22px))) !important;
        pointer-events: auto !important;
      }
      .sticky-action-btn {
        pointer-events: auto !important;
        cursor: pointer !important;
        touch-action: manipulation !important;
      }
    </style>
    {{ content_for_header }}
  </head>

  <body class="folea-theme-body template-{{ template.name }}">
    {% section 'folea-announcement' %}
    {% section 'folea-header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'folea-footer' %}

    {{ 'folea-theme.js' | asset_url | script_tag }}
    <!-- Folea Storefront Clean 2.0 -->
  </body>
</html>
